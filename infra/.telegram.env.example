# Example: local overrides for tg-adapter

# Bot and agent connectivity
TG_MODE=polling
TG_BOT_TOKEN=123456789:TEST_TOKEN_VALUE
AGENT_BASE_URL=http://agent-server:3000
# Optional bearer token if agent requires auth
AGENT_AUTH_TOKEN=mock-agent-bearer-token
# Alternative header-based secret if agent expects API key header
AGENT_API_KEY=optional-agent-api-key

# Comma separated list of allowed private chat/user ids
ALLOWED_CHAT_IDS=987654321,123123123

# Polling and agent HTTP timeouts in milliseconds
TG_POLLING_TIMEOUT_MS=30000
AGENT_TIMEOUT_MS=45000

# Health check port
HEALTH_PORT=8081

# Drop backlog on restart
TG_DROP_PENDING_UPDATES=true

# Streaming configuration
# Valid values: disabled | edit
STREAMING_MODE=disabled
STREAMING_MIN_EDIT_INTERVAL_MS=400
