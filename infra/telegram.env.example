# Example: local overrides for tg-adapter
TG_MODE=polling
TG_BOT_TOKEN=123456789:TEST_TOKEN_VALUE
AGENT_BASE_URL=http://agent-server:3000
# Optional bearer token if agent requires auth
AGENT_AUTH_TOKEN=mock-agent-bearer-token
# Allow either single chat id or comma separated list
ALLOWED_CHAT_ID=987654321
TG_ALLOWED_CHAT_IDS=987654321,123123123
# Polling and agent HTTP timeouts in milliseconds
TG_POLLING_TIMEOUT_MS=30000
AGENT_TIMEOUT_MS=15000
# Health check port
HEALTH_PORT=8081
# Drop backlog on restart
TG_DROP_PENDING_UPDATES=true
