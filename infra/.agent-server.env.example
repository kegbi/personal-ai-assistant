# Example settings for the agent-server service

# Core HTTP server
PORT=3000

# Redis connection
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=optional-redis-password
REDIS_TLS=false
REDIS_TLS_REJECT_UNAUTHORIZED=true

# Memory windows for short-term context
MEM_WINDOW_SIZE=15
HANDLE_TTL_SECONDS=7200

# AI provider defaults
OPENAI_API_KEY=replace-with-openai-key
LLM_MODEL=gpt-5-mini

# Monica CRM integration
MONICA_API_URL=https://app.monicahq.com/api
MONICA_API_TOKEN=replace-with-token
MONICA_WEB_URL=https://app.monicahq.com
MONICA_TIMEOUT_MS=10000
MONICA_MAX_RETRIES=3
MONICA_RETRY_BASE_MS=300
MONICA_MAX_PAGES=100

# Reminders cache TTL (seconds)
REMINDERS_CACHE_TTL_SEC=300

# Feature flags
ENABLE_CHECKPOINTER=false
ENABLE_STREAMING=false
ENABLE_IDEMPOTENCY=false

# Shared auth token used by downstream adapters (optional)
AGENT_AUTH_TOKEN=optional-shared-secret

# Logging and tracing
LOG_FORMAT=pretty
ENABLE_OTEL_TRACING=false
OTEL_EXPORTER=console
# Required when OTEL_EXPORTER=otlp
# OTEL_OTLP_ENDPOINT=https://otel-collector:4317

# Rate limiting
RATE_LIMIT_PER_MIN=60
RATE_LIMIT_BURST=10
